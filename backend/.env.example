OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_FINAL_MODEL=gpt-4.1

APP_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234
ADMIN_EMAIL=admin@example.com
# Local demonstration password. Change this before any public deployment.
ADMIN_PASSWORD=admin1234

#accounts for supervised testing round.
SEED_TESTING_USERS=false
TESTING_ACCOUNT_COUNT=20
TESTING_ACCOUNT_EMAIL_PREFIX=tester
TESTING_ACCOUNT_DOMAIN=example.com
TESTING_ACCOUNT_PASSWORD_PREFIX=replace-with-a-private-prefix-

ADMIN_EXPORT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIT_ENABLED=false

# Relative paths are resolved from the repository root.
KRAKEN_PDF_DIR=data/kraken_PDFs
CHROMA_DIR=storage/chroma
SQLITE_PATH=storage/app.db

WEB_CRAWL_DEFAULT_ALLOWED_DOMAINS=kraken.com,www.kraken.com,support.kraken.com,docs.kraken.com
WEB_CRAWL_DEFAULT_MAX_PAGES=25
WEB_CRAWL_DEFAULT_MAX_DEPTH=1
WEB_CRAWL_DELAY_SECONDS=0.5
WEB_CRAWL_TIMEOUT_SECONDS=15

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
AUTO_INGEST_ON_START=false
FORCE_REINDEX_ON_START=false

FIXED_CHUNK_WORDS=320
FIXED_CHUNK_OVERLAP=60
SECTION_CHUNK_WORDS=380
SECTION_CHUNK_OVERLAP=70
SECTION_MIN_CHUNK_WORDS=20

MIN_RETRIEVAL_SCORE=0.18
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARS_PER_CHUNK=1800
METADATA_RERANK_ENABLED=true
METADATA_RERANK_CANDIDATE_MULTIPLIER=4
HYBRID_CANDIDATE_MULTIPLIER=2
METADATA_TITLE_BOOST=0.22
METADATA_SECTION_BOOST=0.08
